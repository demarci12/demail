# Supabase project URL (Project settings > API). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Public, safe in the browser because RLS guards every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only, bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key (resend.com). Server only.
RESEND_API_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <value>" to /api/cron/send. Min 16 chars.
CRON_SECRET=
# Secret used to sign unsubscribe links. Min 32 chars. Changing it invalidates old links.
UNSUBSCRIBE_SECRET=
# Public base URL of this deployment, no trailing slash (used in links inside mail).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max enrollments sent per scheduler tick. Optional, default 20.
SEND_BATCH_SIZE=20
# Max mails the whole instance sends per day. Optional, default 100 (Resend free tier).
INSTANCE_DAILY_SEND_CAP=100
# Optional. 32 bytes, base64 (openssl rand -base64 32). Seals Google and Microsoft tokens. Required to connect those mailboxes.
MAILBOX_ENCRYPTION_KEY=
# Optional. The previous key while rotating MAILBOX_ENCRYPTION_KEY.
MAILBOX_ENCRYPTION_KEY_PREVIOUS=
# Optional. Google OAuth client (enables Connect Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Microsoft Entra app (enables Connect Microsoft).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Entra tenant id, or common (default), organizations, consumers.
MICROSOFT_TENANT=common
# Optional. Mailboxes read per sync tick. Default 5.
SYNC_BATCH_SIZE=5
# Optional. Messages read per mailbox per tick. Default 50.
SYNC_MESSAGES_PER_MAILBOX=50
