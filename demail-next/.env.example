# Supabase project URL (Project settings > API). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Public, safe in the browser because RLS guards every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only, bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key (resend.com). Server only.
RESEND_API_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <value>" to /api/cron/send. Min 16 chars.
CRON_SECRET=
# Secret used to sign unsubscribe links. Min 32 chars. Changing it invalidates old links.
UNSUBSCRIBE_SECRET=
# Public base URL of this deployment, no trailing slash (used in links inside mail).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max enrollments sent per scheduler tick. Optional, default 20.
SEND_BATCH_SIZE=20
# Max mails the whole instance sends per day. Optional, default 100 (Resend free tier).
INSTANCE_DAILY_SEND_CAP=100
# Optional. 32 bytes, base64 (openssl rand -base64 32). Seals Google and Microsoft tokens. Required to connect those mailboxes.
MAILBOX_ENCRYPTION_KEY=
# Optional. The previous key while rotating MAILBOX_ENCRYPTION_KEY.
MAILBOX_ENCRYPTION_KEY_PREVIOUS=
# Optional. Google OAuth client (enables Connect Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Microsoft Entra app (enables Connect Microsoft).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Entra tenant id, or common (default), organizations, consumers.
MICROSOFT_TENANT=common
# Optional. Resend webhook signing secret (whsec_...). Without it /api/webhooks/resend answers 503.
RESEND_WEBHOOK_SECRET=
# Optional. Mailboxes read per sync tick. Default 5.
SYNC_BATCH_SIZE=5
# Optional. Messages read per mailbox per tick. Default 50.
SYNC_MESSAGES_PER_MAILBOX=50
# Optional. Warmup jobs run per tick. Default 10, max 50.
WARMUP_BATCH_SIZE=10
# Optional. Instance AI key shared by every workspace on this instance. Leave empty on a shared or public instance.
AI_API_KEY=
# Optional. OpenAI-compatible base URL for the instance key. Default https://api.openai.com/v1. A local Ollama works: http://localhost:11434/v1
AI_BASE_URL=
# Optional. Default model. Default gpt-4o-mini.
AI_MODEL=
# Optional. Max AI calls per UTC day made with the instance key, across all workspaces. Default 100.
AI_INSTANCE_DAILY_CALL_CAP=100
# Optional. Cloudflare Turnstile site key for hosted forms. Public, shown in the form page. Both Turnstile keys empty means Turnstile is off; the honeypot, fill-time check and rate limits still apply.
TURNSTILE_SITE_KEY=
# Optional. Cloudflare Turnstile secret key. Server only.
TURNSTILE_SECRET_KEY=
# Optional. Where hosted forms and website tracking read the visitor address for their per-IP limits. Empty: X-Real-IP, which Vercel sets and a self-host proxy must overwrite. 0: no header, all visitors share one bucket. 1 to 10: the Nth X-Forwarded-For entry from the right, for N proxies that append to it.
TRUSTED_PROXY_HOPS=
# Optional. Comma separated DNS blocklist zones that replace the defaults (dbl.spamhaus.org, multi.surbl.org, multi.uribl.com). At most 8. Only domain-name lists work; respect each list's usage terms.
DNSBL_ZONES=
